{
  "name": "APP_NAME",
  "version": "1.0.0",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "build:types": "tsc -p tsconfig-build-types.json",
    "check:types": "tsc",
    "check:types:watch": "tsc --watch",
    "coverage": "NODE_OPTIONS=--experimental-vm-modules jest --config ./jest.config.js --coverage",
    "lint": "standard",
    "lint:fix": "standard --fix",
    "migrate:generate": "drizzle-kit generate",
    "migrate:run": "node src/migrate.js",
    "prepare": "husky",
    "release:first": "npm run release -- --first-release",
    "start": "node bin/www/index.js",
    "start:dev": "node --inspect=0.0.0.0:9229 --watch bin/www/index.js",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --detectOpenHandles --forceExit",
    "test:watch": "npm run test -- --watch"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "description": "",
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "standard": {
    "includes": [
      "tests"
    ]
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "commitizen": "^4.3.1",
    "cz-conventional-changelog": "^3.3.0",
    "drizzle-kit": "^0.28.1",
    "husky": "^9.1.6",
    "jest": "^29.7.0",
    "standard": "^17.1.2"
  },
  "dependencies": {
    "@fastify/compress": "^8.0.1",
    "@fastify/cors": "^10.0.1",
    "@fastify/csrf-protection": "^7.0.1",
    "@fastify/helmet": "^12.0.1",
    "@fastify/multipart": "^9.0.3",
    "@fastify/swagger": "^9.4.0",
    "@fastify/swagger-ui": "^5.1.0",
    "drizzle-orm": "^0.36.4",
    "fastify": "^5.0.0",
    "http-status-codes": "^2.3.0",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "pino-tee": "^0.3.0",
    "postgres": "^3.4.5"
  }
}
